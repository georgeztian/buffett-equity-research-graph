# Optional. Copy this file to .env and put in YOUR OWN name and contact email (or run:
#   python -m graph --set-sec-contact "Your Name you@yourdomain.com"
# ). It enables the SEC data pack: SEC EDGAR requires automated clients to identify themselves, so no request
# is sent to SEC without it. Set it to `declined` to run without the data pack and not be asked again.
# .env is gitignored: it stays on your machine and is sent only to SEC, in the User-Agent header.
SEC_USER_AGENT=Your Name your.email@domain.com
